{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Capybit",
  "version": "0.0.1",
  "identifier": "dev.cipher.capybit",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Capybit",
        "width": 192,
        "height": 192,
        "x": 1600,
        "y": 800,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false
      },
      {
        "label": "birth",
        "title": "Capybit",
        "url": "birth.html",
        "width": 520,
        "height": 420,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "resizable": false,
        "shadow": true,
        "visible": false
      },
      {
        "label": "bubble",
        "title": "Capybit",
        "url": "bubble.html",
        "width": 360,
        "height": 240,
        "x": 1380,
        "y": 760,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
